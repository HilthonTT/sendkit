{
  "name": "sendkit-workspace",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HilthonTT/sendkit.git"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:cli": "bun run apps/cli/src/index.ts",
    "dev:local-mcp": "bun run apps/local-mcp/src/index.ts",
    "dev:remote-mcp": "bun run apps/remote-mcp/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
